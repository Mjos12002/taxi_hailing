<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#0D1A3B">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <fragment
                android:id="@+id/map"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_margin="10sp"
            android:elevation="20sp"
            app:cardBackgroundColor="#202042"
            app:cardCornerRadius="5sp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:padding="10sp">

                <RelativeLayout
                    android:id="@+id/rl_location_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true">

                    <ImageView
                        android:id="@+id/img_location_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/location_small"
                        android:layout_centerVertical="true"/>


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/img_location_icon"
                        android:layout_marginStart="10sp">

                        <TextView
                            android:id="@+id/tv_your_location_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:textColor="@color/white"
                            android:text="@string/your_location"
                            android:layout_alignParentTop="true"
                            android:textSize="15sp"/>

                        <TextView
                            android:id="@+id/tv_current_address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:textColor="#BCBCBC"
                            android:textSize="17sp"
                            android:text="Here we are"
                            android:layout_below="@+id/tv_your_location_label"/>

                    </RelativeLayout>



                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_separator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rl_location_info">

                    <ImageView
                        android:id="@+id/img_more_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/more_small"
                        android:layout_alignParentTop="true"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:background="@drawable/border_bottom"
                        android:layout_toRightOf="@id/img_more_location"
                        android:layout_marginStart="10sp"/>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rl_destination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rl_separator">

                    <ImageView
                        android:id="@+id/img_destination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/destinationcopy"
                        android:layout_centerVertical="true"/>

                    <EditText
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="Votre destination"
                        android:fontFamily="sans-serif-light"
                        android:textColorHint="#fff"
                        android:textColor="@color/black"
                        android:padding="2sp"
                        android:layout_marginStart="10sp"
                        android:background="@drawable/border_bottom"
                        android:layout_toEndOf="@id/img_destination"/>
                </RelativeLayout>
                <Button
                    android:id="@+id/btn_book_taxi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/more_icon"
                    android:layout_below="@id/rl_destination"
                    android:layout_alignParentEnd="true"
                    android:text="@string/order_taxi"
                    android:minHeight="0sp"
                    android:padding="8sp"
                    android:layout_marginTop="10sp"
                    android:textColor="#FFF300"
                    android:background="@drawable/order_button_background"/>

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</FrameLayout>