<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <solid
                android:color="#fff" />
            <padding
                android:left="5sp"
                android:top="5sp"
                android:right="5sp"
                android:bottom="5sp"/>
            <stroke
                android:color="#E4E4E4"
                android:width="1sp"/>
            <corners
                android:radius="5sp" />

        </shape>
    </item>
</selector>